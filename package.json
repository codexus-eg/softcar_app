{
  "name": "softcar-mobile-passenger",
  "version": "1.13.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:debug": "cd android && gradlew.bat app:assembleDebug",
    "android:release": "cd android && gradlew.bat app:assembleRelease",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "eas:init": "npx eas-cli@latest init --id bf068d74-eb79-4428-a802-3e78f849420e",
    "eas:build:android": "npx eas-cli@latest build --platform android --profile production",
    "eas:build:ios": "npx eas-cli@latest build --platform ios --profile production",
    "eas:build:all": "npx eas-cli@latest build --platform all --profile production",
    "eas:update:preview": "npx eas-cli@latest update --channel preview",
    "eas:update:production": "npx eas-cli@latest update --channel production",
    "eas:submit:android": "npx eas-cli@latest submit --platform android --profile production",
    "eas:submit:ios": "npx eas-cli@latest submit --platform ios --profile production",
    "eas:build-submit": "npx eas-cli@latest build --platform all --profile production --auto-submit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "babel-preset-expo": "~56.0.0",
    "expo": "~56.0.9",
    "expo-calendar": "~56.0.8",
    "expo-constants": "~56.0.17",
    "expo-file-system": "~56.0.7",
    "expo-local-authentication": "~56.0.4",
    "expo-location": "~56.0.16",
    "expo-notifications": "~56.0.16",
    "expo-print": "~56.0.3",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.16",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-updates": "~56.0.18",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-webview": "13.16.1",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.2.10",
    "typescript": "~6.0.3"
  }
}
