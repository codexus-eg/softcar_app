# Node modules (مجلد المكتبات - حجمه كبير جداً ولا يجب رفعه)
node_modules/
npm-debug.log
yarn-error.log

# Expo (ملفات إكسبو المؤقتة)
.expo/
web-build/

# Environment Variables (ملفات المتغيرات البيئية التي تحتوي على كلمات السر ومفاتيح API)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Custom Build / Dist Folders (مجلدات البناء التي تظهر لديك في المشروع)
dist-*/
dist/
build/

# Credentials (مجلد الصلاحيات والمفاتيح - ينصح بشدة عدم رفعه للحفاظ على الأمان)
credentials/

# Native Build Artifacts (ملفات بناء أندرويد و iOS)
android/app/build/
ios/build/
android/.gradle
android/app/build
android/build

# OS Files (ملفات النظام الخفية)
.DS_Store
Thumbs.db